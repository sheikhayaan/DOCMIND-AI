# ── Core providers ────────────────────────────────────────────────────────────
GROQ_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
FRONTEND_URL=

# ── Authentication ────────────────────────────────────────────────────────────
# Required in production: stable HMAC key for anonymous/session tokens.
AUTH_SECRET=
# Separate secret for the admin bearer token (never reuse AUTH_SECRET).
ADMIN_ACCESS_TOKEN=
# Admin identity shown in the UI. Leave blank to disable the admin shortcut.
ADMIN_EMAIL=
# Optional Google Sign-In. Leave blank to keep it disabled (anonymous sessions still work).
# Create an OAuth 2.0 Web Client ID in Google Cloud Console and paste it here.
GOOGLE_CLIENT_ID=

# ── Runtime / storage ─────────────────────────────────────────────────────────
ENVIRONMENT=development
# Number of trusted reverse-proxy hops in X-Forwarded-For (0 when the API is
# directly exposed; 1 on Render/one nginx/ALB in front of the API).
TRUSTED_PROXY_HOPS=0
SECURITY_DB_PATH=.data/security.sqlite3
DOCMIND_DATA_DIR=.data
DOCMIND_STAGING_DIR=.data/staging
MAX_PDF_PAGES=500
# 32-byte key encoded as base64 or hex. Required in production; generate with:
# python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
DOCUMENT_ENCRYPTION_KEY=

# ── Ingestion queue ───────────────────────────────────────────────────────────
# celery = Redis-backed Celery workers (production). inline = background thread (local dev).
QUEUE_BACKEND=inline
REDIS_URL=redis://127.0.0.1:6379/0
INGESTION_QUEUE_NAME=docmind
INGESTION_JOB_TIMEOUT_SECONDS=900

# ── Upload antivirus (fail-closed) ────────────────────────────────────────────
# Leave CLAMAV_HOST blank only for local development. Production requires it.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=15
CLAMAV_REQUIRED=true

# ── Bot defense (reCAPTCHA v3) ────────────────────────────────────────────────
# Leave blank locally. Production requires the secret key.
RECAPTCHA_SECRET_KEY=

# ── Observability ─────────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.05

# ── Browser security headers ──────────────────────────────────────────────────
# Comma-separated origins the frontend needs to reach from the browser.
CSP_CONNECT_SRC=http://localhost:8000,https://api.docmind.ai
